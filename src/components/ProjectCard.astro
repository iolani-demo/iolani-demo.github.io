---
import VideoEmbed from './VideoEmbed.astro'
import type { Project } from '../data/projects'

type Props = Project
const { title, description, url, videoUrl, tags } = Astro.props
---

<article class="border border-slate-200 dark:border-slate-800 rounded-xl p-6 flex flex-col gap-4">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold text-slate-900 dark:text-white">{title}</h2>
      <p class="mt-1 text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{description}</p>
    </div>
    {url && (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline"
      >
        View →
      </a>
    )}
  </div>

  {tags && tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map(tag => (
        <li class="text-xs px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
          {tag}
        </li>
      ))}
    </ul>
  )}

  {videoUrl && <VideoEmbed url={videoUrl} title={title} />}
</article>
