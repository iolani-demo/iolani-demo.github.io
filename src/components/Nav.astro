---
const navLinks = [
  { href: '/', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
]

const currentPath = Astro.url.pathname
---

<nav class="border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-3xl mx-auto px-6 flex items-center justify-between h-14">
    <a href="/" class="font-semibold text-slate-900 dark:text-white tracking-tight">
      Your Name <!-- replace with your name -->
    </a>
    <ul class="flex gap-6">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`text-sm transition-colors ${
              currentPath === href
                ? 'text-slate-900 dark:text-white font-medium'
                : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
            }`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
