---
import Base from '../layouts/Base.astro'
---

<Base title="About — Your Name" description="About me page">
  <section class="flex flex-col gap-8">
    <div class="flex items-start gap-6">
      <!-- Replace src with your photo URL or a local file in /public -->
      <img
        src="https://avatars.githubusercontent.com/u/0"
        alt="Your Name"
        width="96"
        height="96"
        class="rounded-full w-24 h-24 object-cover shrink-0 bg-slate-100"
      />
      <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Your Name</h1>
        <p class="mt-1 text-slate-500 dark:text-slate-400">Your title / one-line description</p>
        <div class="mt-3 flex gap-4 text-sm">
          <a href="https://github.com/iolani-demo" target="_blank" rel="noopener noreferrer" class="text-indigo-600 dark:text-indigo-400 hover:underline">GitHub</a>
          <a href="https://linkedin.com/in/iolani-demo" target="_blank" rel="noopener noreferrer" class="text-indigo-600 dark:text-indigo-400 hover:underline">LinkedIn</a>
          <a href="mailto:your@email.com" class="text-indigo-600 dark:text-indigo-400 hover:underline">Email</a>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-4 text-slate-600 dark:text-slate-400 leading-relaxed">
      <p>
        Write a few sentences about yourself here. What do you work on? What are you interested in?
        What are you currently building or learning?
      </p>
      <p>
        This is a good place to mention your background, current focus, and what kinds of projects
        you tend to work on.
      </p>
    </div>
  </section>
</Base>
